			defaultHierarchy: LocalDateTable_402175d5-d468-4c03-bb90-2df64bb85d54.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Order Date' =
			
			DATE(
			    YEAR(orders[order_purchase_timestamp]),
			    MONTH(orders[order_purchase_timestamp]),
			    DAY(orders[order_purchase_timestamp])
			)
		formatString: Long Date
		lineageTag: edd4d2b1-26c0-43f3-8d10-3e0b23581c13
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Delivery Performance' =
			
			IF(
			    orders[order_status] = "delivered"
			        && NOT(ISBLANK(orders[order_delivered_customer_date]))
			        && NOT(ISBLANK(orders[order_estimated_delivery_date])),
			    IF(
			        orders[order_delivered_customer_date] <= orders[order_estimated_delivery_date],
			        "On-time",
			        "Late"
			    ),
			    BLANK()
			)
		lineageTag: 62fea830-429a-4d86-af04-6f4d388daef7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition orders = m
		mode: import
		source =
				let
				    Source = Sql.Database("localhost\MSSQLSERVER01", "Olist_Analysis"),
				    dbo_orders = Source{[Schema="dbo",Item="orders"]}[Data]
				in
				    dbo_orders

	annotation PBI_ResultType = Table

